{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\"; if [ -x \"$p\" ]; then \"$p\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_hook.py\"; fi",
            "timeout": 30,
            "statusMessage": "ruff format + check"
          }
        ]
      }
    ]
  }
}
